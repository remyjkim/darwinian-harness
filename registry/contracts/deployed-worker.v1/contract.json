        "name",
        "environment",
        "workerRevision",
        "bindingRevision",
        "retired"
      ],
      "properties": {
        "organizationId": {
          "$ref": "#/idKinds/OrganizationId"
        },
        "workerId": {
          "$ref": "#/idKinds/WorkerId"
        },
        "deployedWorkerId": {
          "$ref": "#/idKinds/DeployedWorkerId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
