    "i336ArchitectureCommit": "9296fc4547ba2b8e1c11991dc62811c30c9020b3",
    "i321CandidateCommit": "3a690760ad30b0dc002ffe6589d8b83d81109929",
    "workerArchitectureCommit": "5f07dec423fac4289c3e26cad441e816e8bf1203"
  },
  "profiles": {
    "production": {
      "profileId": "production",
      "apiOrigin": "https://api.darwinian.dev",
      "webOrigin": "https://foundry.darwinian.dev",
      "authHubOrigin": "https://auth.darwinian.dev",
      "issuer": "https://auth.darwinian.dev/api/auth",
      "resource": "https://api.darwinian.dev",
      "clientId": "drwn-cli",
      "requestedScopes": [
        "openid",
        "email",
        "offline_access",
        "dah:management.delegate"
      ]
    },
    "staging": {
      "profileId": "staging",
      "apiOrigin": "https://api-staging-main.darwinian.dev",
      "webOrigin": "https://foundry-staging-main.darwinian.dev",
      "authHubOrigin": "https://auth-staging-main.darwinian.dev",
      "issuer": "https://auth-staging-main.darwinian.dev/api/auth",
      "resource": "https://api.darwinian.dev",
      "clientId": "drwn-cli",
      "requestedScopes": [
        "openid",
        "email",
        "offline_access",
        "dah:management.delegate"
      ]
    }
  },
  "headers": {
    "required": [
      {
        "name": "Authorization",
        "semantics": "services-bearer-only"
      },
      {
        "name": "X-Drwn-Protocol",
        "semantics": "exact-protocol"
      },
      {
        "name": "X-Drwn-Version",
        "semantics": "client-version"
      },
      {
        "name": "X-Request-Id",
        "semantics": "lowercase-uuidv4-and-sole-mutation-idempotency-identity"
      }
    ],
    "mutationIdempotencyHeader": "X-Request-Id"
  },
  "idKinds": {
    "OrganizationId": {
      "title": "OrganizationId",
      "type": "string",
      "pattern": "^org_[A-Za-z0-9._:-]+$",
      "maxLength": 128
    },
    "WorkerId": {
      "title": "WorkerId",
      "type": "string",
      "pattern": "^worker_[A-Za-z0-9._:-]+$",
      "maxLength": 128
    },
    "DeployedWorkerId": {
      "title": "DeployedWorkerId",
      "type": "string",
      "pattern": "^deployed_worker_[A-Za-z0-9._:-]+$",
      "maxLength": 128
    },
    "DeploymentId": {
      "title": "DeploymentId",
      "type": "string",
      "pattern": "^deployment_attempt_[A-Za-z0-9._:-]+$",
      "maxLength": 128
    },
    "RunId": {
      "title": "RunId",
      "type": "string",
      "pattern": "^run_[A-Za-z0-9._:-]+$",
      "maxLength": 128
    },
    "RequestId": {
      "title": "RequestId",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "enums": {
    "environment": [
      "development",
      "staging",
      "production"
    ],
    "runStatus": [
      "queued",
      "running",
      "succeeded",
      "failed",
      "cancelled"
    ],
    "operationOutcome": [
      "succeeded",
      "refused",
      "indeterminate"
    ]
  },
  "schemas": {
    "PageLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "Cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "PositiveRevision": {
      "type": "integer",
      "minimum": 1
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Environment": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
