      "properties": {
        "deploymentId": {
          "$ref": "#/idKinds/DeploymentId"
        },
        "deployedWorkerId": {
          "$ref": "#/idKinds/DeployedWorkerId"
        },
        "artifactRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "status": {
          "type": "string",
          "enum": [
