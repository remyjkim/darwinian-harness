          "$ref": "#/schemas/Environment"
        },
        "workerRevision": {
          "$ref": "#/schemas/PositiveRevision"
        },
        "bindingRevision": {
          "$ref": "#/schemas/PositiveRevision"
        },
        "retired": {
          "type": "boolean"
        }
      }
    },
    "DeploymentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
