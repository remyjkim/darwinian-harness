    "executePath": "/v1/phase-a/execute",
    "cleanupPath": "/v1/phase-a/cleanup",
    "executeTimeoutMs": 15000,
    "cleanupTimeoutMs": 5000,
    "maxResponseBytes": 65536,
    "maxAuthorizationHeaderBytes": 16384,
    "successStatus": 200,
    "responseMediaType": "application/json",
    "responseMediaTypeParameters": "forbidden",
    "responseContentEncoding": "absent",
    "redirect": "error",
    "contentLengthWhenPresent": "canonical_bounded_exact_received_bytes",
    "responseEncoding": "fatal_utf8",
    "transparentRetries": 0,
    "requiredHeadersByMode": {
      "execute": [
        "authorization",
        "x-drwn-protocol",
        "x-drwn-version",
        "x-i321-qualification-run-id",
        "x-request-id"
      ],
      "normalCleanup": [
        "authorization",
        "x-drwn-protocol",
        "x-drwn-version",
        "x-i321-qualification-run-id",
        "x-request-id"
      ],
      "failSafeCleanup": [
        "x-drwn-protocol",
        "x-drwn-version",
        "x-i321-qualification-run-id",
        "x-request-id",
        "x-i321-adapter-process-generation"
      ]
    }
  },
  "adapter": {
    "originFlag": "--phase-a-adapter-origin",
    "originGrammar": "http://127.0.0.1:<canonical-decimal-port-1..65535>",
    "readiness": {
      "path": "/__ready",
      "status": 204,
      "body": "empty",
      "contentLength": 0,
      "contentType": "absent",
      "contentEncoding": "absent",
      "attempts": 100,
      "intervalMs": 100,
      "deadlineMs": 10000
    },
    "bindings": [
      {
        "binding": "DAH_PHASE_A_QUALIFICATION",
        "service": "darwinian-auth-hub-staging-1",
        "entrypoint": "DahPhaseAQualificationApi"
      },
      {
        "binding": "SERVICES_WEB_PHASE_A_QUALIFICATION",
        "service": "services-web-staging-1",
        "entrypoint": "ServicesWebPhaseAQualificationApi"
      }
    ],
    "entrypointMethods": [
      "executePhaseA",
      "readPhaseAAggregates",
      "cleanupPhaseA",
      "failSafeCleanupPhaseA"
    ]
  },
  "authorization": {
    "header": "Authorization",
    "scheme": "Bearer",
    "producer": "worker_same_run_device_grant",
    "privateRpcArgumentByMode": {
      "execute": "authorizationBearer",
      "aggregate": "authorizationBearer",
      "normalCleanup": "authorizationBearer",
      "failSafeCleanup": null
    },
    "firstUseBinding": [
      "qualificationRunId",
      "sourceCommitSha",
      "bearerDigest",
      "humanActor",
      "adapterProcessGeneration"
    ],
    "replayKey": "x-request-id",
    "rawBearerRetention": "none",
    "failSafeAuthority": "platform_authenticated_launch_controller_plus_run_source_request_generation",
    "forbiddenSurfaces": [
      "argv",
      "environment",
      "body",
      "query",
      "cookie",
      "referrer",
      "file_or_fifo",
      "stdout_stderr",
      "log_trace_exception",
      "artifact_cache_context_receipt"
    ]
  },
  "localOperationOrder": [
    {
      "operation": "fresh_login"
    },
    {
      "operation": "displayed_consent"
    }
  ],
  "remoteOperationOrder": [
