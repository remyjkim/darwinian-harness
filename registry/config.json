{
  "version": 1,
  "targets": {
    "claude": {
      "enabled": true,
      "configPath": "~/.claude/settings.json",
      "userMcpPath": "~/.claude.json",
      "format": "json-merge",
      "mcpKey": "mcpServers"
    },
    "codex": {
      "enabled": true,
      "configPath": "~/.codex/config.toml",
      "format": "toml-merge",
      "mcpKey": "mcp_servers"
    },
    "cursor": {
      "enabled": false,
      "notes": "Deprecated (owner decision 2026-08-05, tracked as I213): cursor support was never live-verified and will be removed in a later release. Enable explicitly to keep projecting.",
      "configPath": "~/.cursor/mcp.json",
      "format": "json-standalone",
      "mcpKey": "mcpServers"
    },
    "opencode": {
      "enabled": false,
      "configPath": "~/.config/opencode/opencode.json",
      "format": "json-merge",
      "mcpKey": "mcp"
    }
  },
  "defaults": {
    "communityCatalogUrl": "https://github.com/curation-labs/dm-cards-catalog-v1.git"
  },
  "parallel": {
    "cli": {
      "enabled": true
    },
    "mcp": {
      "enabled": false
    }
  },
  "catalogs": {
    "npmSkills": {
      "enabled": true,
      "searchLimit": 20
    },
    "mcp": {
      "enabled": false,
      "sources": []
    }
  },
  "optional": {
    "drwn-command-bridge": false,
    "markdownify": false,
    "notion": true,
    "slack": false
  }
}
